%% Servicios, persistencia e infraestructura
classDiagram
  direction LR
  class ErrorNegocio {
    <<exception>>
    +list~str~ errores
  }
  class NoEncontrado {
    <<exception>>
  }
  class ServicioRed {
    +obtenerRed() RedLogistica
    +validar(red) list~str~
    +actualizarRed(red) RedLogistica
    +restablecer() RedLogistica
  }
  class ServicioOptimizacion {
    +instanciaActual() InstanciaTransporte
    +resolver(metodo, parametros) tuple
    +comparar(parametros, corridas) tuple
  }
  class ServicioSensibilidad {
    +analizar(escenario) tuple
  }
  class ServicioReportes {
    +listar(limite) list~dict~
    +obtener(ejecucionId) dict
  }
  class ServicioRutas {
    +rutasDeLaRed(red, descargar, alAvanzar) ResultadoRutas
  }
  class IRedRepository {
    <<interface>>
    +obtenerRed() RedLogistica
    +guardar(red)
    +estaVacia() bool
  }
  class IEjecucionRepository {
    <<interface>>
    +guardarComparacion(comparacion, parametros, corridas, detalle) int
    +listar(limite) list~dict~
    +obtener(ejecucionId) dict
  }
  class RedRepository {
    +Session sesion
    +estaVacia() bool
    +obtenerRed() RedLogistica
    +guardar(red)
  }
  class EjecucionRepository {
    +Session sesion
    +guardarComparacion(comparacion, parametros, corridas, detalle) int
    +guardar(datos) int
    +listar(limite) list~dict~
    +obtener(ejecucionId) dict
  }
  class AgroempresaModelo {
    <<ORM>>
    +str id PK
    +int orden
    +str nombre
    +str municipio
    +str tipo_residuo
    +float oferta_t
    +float lat
    +float lon
  }
  class PlantaModelo {
    <<ORM>>
    +str id PK
    +int orden
    +str nombre
    +str municipio
    +float capacidad_t
    +float costo_operacion
    +bool activa
    +float lat
    +float lon
  }
  class RutaModelo {
    <<ORM>>
    +str agroempresa_id PK FK
    +str planta_id PK FK
    +float distancia_km
    +bool habilitada
  }
  class ParametrosModelo {
    <<ORM>>
    +int id PK
    +float tarifa_t_km
    +float precio_tonelada
    +float gran_m
  }
  class EjecucionModelo {
    <<ORM>>
    +int id PK
    +datetime fecha
    +str tipo
    +float z_exacto
    +float z_ag_mejor
    +float z_ag_promedio
    +float desv_estandar
    +float gap_pct
    +float tiempo_exacto_s
    +float tiempo_ag_s
    +int corridas
    +dict parametros
    +dict resultado
  }
  class IProveedorRutas {
    <<interface>>
    +trazar(origen, destino) RutaCarretera
  }
  class ProveedorOsrm {
    +str urlBase
    +float tiempoMaximo
    +float esperaTrasFallo
  }
  class CacheRutas {
    +Path archivo
    +clave(origen, destino) str
    +obtener(origen, destino) RutaCarretera
    +agregar(origen, destino, ruta)
    +escribir()
  }
  class RutaCarretera {
    +list~Punto~ puntos
    +float distancia_km
    +float duracion_min
  }
  class ResultadoRutas {
    +list~TramoCarretera~ tramos
    +int faltantes
    +bool sin_conexion
  }
  class TramoCarretera {
    +str agroempresa_id
    +str planta_id
    +RutaCarretera ruta
  }
  class ValidadorRed {
    +float tolerancia
    +validar(red) list~str~
  }
  class SolverFactory {
    -dict _creadores
    +registrar(metodo, creador)
    +metodos() list~str~
    +crear(metodo, parametros) ISolver
    +exacto() ISolver
    +genetico(parametros) ISolver
  }
  class InstanciaBuilder {
    +construir(red) InstanciaTransporte
  }
  class Comparador {
    +SolverFactory fabrica
    +comparar(inst, p, corridas) Comparacion
  }
  class SimuladorEscenarios {
    +ISolver solver
    +simular(inst, esc) list~PasoEscenario~
  }
  class AnalizadorSensibilidad {
    +analizar(sol, inst) ResultadoSensibilidad
  }
  ServicioRed o-- IRedRepository
  ServicioRed o-- ValidadorRed
  ServicioOptimizacion o-- IRedRepository
  ServicioOptimizacion o-- IEjecucionRepository
  ServicioOptimizacion o-- SolverFactory
  ServicioOptimizacion o-- ValidadorRed
  ServicioOptimizacion o-- InstanciaBuilder
  ServicioOptimizacion ..> Comparador
  ServicioSensibilidad o-- IRedRepository
  ServicioSensibilidad o-- AnalizadorSensibilidad
  ServicioSensibilidad o-- SimuladorEscenarios
  ServicioSensibilidad o-- ValidadorRed
  ServicioReportes o-- IEjecucionRepository
  ServicioRutas o-- IRedRepository
  ServicioRutas o-- CacheRutas
  ServicioRutas o-- IProveedorRutas
  ServicioRutas ..> ResultadoRutas
  ResultadoRutas "1" *-- "0..*" TramoCarretera
  TramoCarretera --> RutaCarretera
  CacheRutas ..> RutaCarretera
  IProveedorRutas <|.. ProveedorOsrm
  IRedRepository <|.. RedRepository
  IEjecucionRepository <|.. EjecucionRepository
  RedRepository ..> AgroempresaModelo
  RedRepository ..> PlantaModelo
  RedRepository ..> RutaModelo
  RedRepository ..> ParametrosModelo
  EjecucionRepository ..> EjecucionModelo
  ServicioOptimizacion ..> ErrorNegocio
  ServicioReportes ..> NoEncontrado
